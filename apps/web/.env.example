# Public Privy App ID from the Privy dashboard. Leave empty to disable authentication.
NEXT_PUBLIC_PRIVY_APP_ID=

# Fastify API prefix. The browser sends Trickle session tokens only to this origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Never put a Privy App Secret in this frontend or in a NEXT_PUBLIC_ variable.

# Public payout address (same value as PAYOUT_ADDRESS in apps/api for this environment).
# Family cash-out sends mock AUSD here. Leave empty until the backend confirms it:
# the transfer button stays disabled. This is an address, never a private key.
NEXT_PUBLIC_PAYOUT_ADDRESS=
