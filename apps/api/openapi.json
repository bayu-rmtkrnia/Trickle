                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invite"
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "description": "Pass as `cursor` to get the next page. `null` on the last page.",
