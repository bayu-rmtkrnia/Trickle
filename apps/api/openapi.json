{
  "openapi": "3.0.3",
  "info": {
    "title": "Trickle API",
    "version": "1.1.0",
    "description": "Metadata API for Trickle: auth, employers, invites, gas sponsorship and FX. Money lives on-chain; this API never stores balances.\n\nResource endpoints live under `/api/v1`. Errors always use `{ error: { code, message, details? } }`: 400 for unreadable requests, 422 for schema validation failures (one `details` entry per field). List endpoints take `?limit=&cursor=` and return `{ data, nextCursor }`."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorInput": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable code, e.g. INVITE_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation"
              },
              "details": {}
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "displayName": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["id", "address", "displayName", "createdAt"]
      },
      "EmployerInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "nullable": true,
            "type": "string"
          },
          "ownerAddress": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["id", "name", "country", "ownerAddress", "createdAt"]
      },
      "FxQuoteInput": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string",
            "enum": ["USD"]
          },
          "quote": {
            "type": "string",
            "enum": ["IDR"]
          },
          "rate": {
            "type": "number",
            "description": "IDR per 1 USD"
          },
          "source": {
            "type": "string",
            "enum": ["live", "cache", "fallback"],
            "description": "`fallback` means the provider was unreachable and no cached rate exists"
          },
          "rateTime": {
            "nullable": true,
            "description": "When the provider last updated the rate",
            "type": "string"
          },
          "fetchedAt": {
            "nullable": true,
            "description": "When this server fetched the rate",
            "type": "string"
          }
        },
        "required": ["base", "quote", "rate", "source", "rateTime", "fetchedAt"]
      },
      "GasDripInput": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SENT", "FAILED"]
          },
          "amountMon": {
            "type": "string"
          },
          "txHash": {
            "nullable": true,
            "type": "string"
          },
          "alreadyDripped": {
            "type": "boolean",
            "description": "true when this address was funded by an earlier call"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["address", "status", "amountMon", "txHash", "alreadyDripped", "createdAt"]
      },
      "InviteInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["WORKER", "FAMILY"]
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "ACCEPTED", "REVOKED", "EXPIRED"]
          },
          "inviteeName": {
            "type": "string"
          },
          "monthlySalaryUsd": {
            "nullable": true,
            "type": "number"
          },
          "relation": {
            "nullable": true,
            "type": "string"
          },
          "invitedBy": {
            "type": "object",
            "properties": {
              "name": {
                "nullable": true,
                "description": "Company name for WORKER, worker name for FAMILY",
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            },
            "required": ["name", "address"]
          },
          "url": {
            "type": "string",
            "description": "Link to share with the invitee"
          },
          "expiresAt": {
            "type": "string"
          },
          "acceptedAt": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "type",
          "status",
          "inviteeName",
          "monthlySalaryUsd",
          "relation",
          "invitedBy",
          "url",
          "expiresAt",
          "acceptedAt",
          "createdAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable code, e.g. INVITE_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation"
              },
              "details": {}
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "displayName": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["id", "address", "displayName", "createdAt"],
        "additionalProperties": false
      },
      "Employer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "nullable": true,
            "type": "string"
          },
          "ownerAddress": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["id", "name", "country", "ownerAddress", "createdAt"],
        "additionalProperties": false
      },
      "FxQuote": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string",
            "enum": ["USD"]
          },
          "quote": {
            "type": "string",
            "enum": ["IDR"]
          },
          "rate": {
            "type": "number",
            "description": "IDR per 1 USD"
          },
          "source": {
            "type": "string",
            "enum": ["live", "cache", "fallback"],
            "description": "`fallback` means the provider was unreachable and no cached rate exists"
          },
          "rateTime": {
            "nullable": true,
            "description": "When the provider last updated the rate",
            "type": "string"
          },
          "fetchedAt": {
            "nullable": true,
            "description": "When this server fetched the rate",
            "type": "string"
          }
        },
        "required": ["base", "quote", "rate", "source", "rateTime", "fetchedAt"],
        "additionalProperties": false
      },
      "GasDrip": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SENT", "FAILED"]
          },
          "amountMon": {
            "type": "string"
          },
          "txHash": {
            "nullable": true,
            "type": "string"
          },
          "alreadyDripped": {
            "type": "boolean",
            "description": "true when this address was funded by an earlier call"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["address", "status", "amountMon", "txHash", "alreadyDripped", "createdAt"],
        "additionalProperties": false
      },
      "Invite": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["WORKER", "FAMILY"]
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "ACCEPTED", "REVOKED", "EXPIRED"]
          },
          "inviteeName": {
            "type": "string"
          },
          "monthlySalaryUsd": {
            "nullable": true,
            "type": "number"
          },
          "relation": {
            "nullable": true,
            "type": "string"
          },
          "invitedBy": {
            "type": "object",
            "properties": {
              "name": {
                "nullable": true,
                "description": "Company name for WORKER, worker name for FAMILY",
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            },
            "required": ["name", "address"],
            "additionalProperties": false
          },
          "url": {
            "type": "string",
            "description": "Link to share with the invitee"
          },
          "expiresAt": {
            "type": "string"
          },
          "acceptedAt": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "type",
          "status",
          "inviteeName",
          "monthlySalaryUsd",
          "relation",
          "invitedBy",
          "url",
          "expiresAt",
          "acceptedAt",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service and database status",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "degraded"]
                    },
                    "db": {
                      "type": "string",
                      "enum": ["ok", "down"]
                    },
                    "uptimeSeconds": {
                      "type": "number"
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "db", "uptimeSeconds", "time"],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "degraded"]
                    },
                    "db": {
                      "type": "string",
                      "enum": ["ok", "down"]
                    },
                    "uptimeSeconds": {
                      "type": "number"
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "db", "uptimeSeconds", "time"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/challenge": {
      "post": {
        "summary": "Get a sign-in message for an address",
        "tags": ["Auth"],
        "description": "Returns an EIP-4361 (Sign-In with Ethereum) message. The client signs `message` with the Mera account and sends it to `/api/v1/auth/verify`. Nonces are single-use and expire after a few minutes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  }
                },
                "required": ["address"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nonce": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    }
                  },
                  "required": ["nonce", "message", "expiresAt"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "summary": "Exchange a signed challenge for a session token",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "signature": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]+$"
                  }
                },
                "required": ["message", "signature"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": ["token", "user"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Current user and the roles they hold",
        "tags": ["Auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "address": {
                      "type": "string"
                    },
                    "displayName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "roles": {
                      "type": "object",
                      "properties": {
                        "employer": {
                          "type": "boolean"
                        },
                        "worker": {
                          "type": "boolean"
                        },
                        "family": {
                          "type": "boolean"
                        }
                      },
                      "required": ["employer", "worker", "family"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["id", "address", "displayName", "createdAt", "roles"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/employers": {
      "post": {
        "summary": "Create the company profile for the signed-in user",
        "tags": ["Employers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "country": {
                    "description": "ISO 3166-1 alpha-2 country code, e.g. MY",
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employer"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/employers/me": {
      "get": {
        "summary": "The signed-in user's company profile",
        "tags": ["Employers"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employer"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update the company profile",
        "tags": ["Employers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "country": {
                    "description": "ISO 3166-1 alpha-2 country code, e.g. MY",
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 2
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employer"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/employers/me/workers": {
      "get": {
        "summary": "Workers who accepted an invite from this company",
        "tags": ["Employers"],
        "description": "Metadata only. Stream balances come from the contract/indexer, never from this API.",
        "parameters": [
          {
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Items per page, 1–100"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "`nextCursor` from the previous page. Omit for the first page."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "address": {
                            "type": "string"
                          },
                          "monthlySalaryUsd": {
                            "type": "number"
                          },
                          "joinedAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "displayName",
                          "address",
                          "monthlySalaryUsd",
                          "joinedAt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "description": "Pass as `cursor` to get the next page. `null` on the last page.",
                      "type": "string"
                    }
                  },
                  "required": ["data", "nextCursor"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invites": {
      "post": {
        "summary": "Create a worker invite (employer) or a family invite (worker)",
        "tags": ["Invites"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["WORKER"]
                      },
                      "inviteeName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "monthlySalaryUsd": {
                        "type": "number",
                        "minimum": 0,
                        "exclusiveMinimum": true,
                        "maximum": 1000000,
                        "multipleOf": 0.01,
                        "description": "Gross monthly salary in USD, up to 2 decimals"
                      }
                    },
                    "required": ["type", "inviteeName", "monthlySalaryUsd"]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["FAMILY"]
                      },
                      "inviteeName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "relation": {
                        "description": "e.g. \"Ibu\", \"Istri\"",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": ["type", "inviteeName"]
                  }
                ]
              }
            }
          }
        },
