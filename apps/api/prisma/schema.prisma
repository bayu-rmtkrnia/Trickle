// Postgres only stores metadata. Balances, streamed amounts and withdrawals
// always come from the contract or indexer (see PLAN §4.2).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum InviteType {
  WORKER
  /// Invites a family member to become one of the worker's recipients
  RECIPIENT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum GasDripStatus {
  PENDING
  SENT
  FAILED
}

enum DemoStreamStatus {
  PENDING
  SENT
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Anyone who signed in with Privy. Role is contextual: the same address
/// can own a company (employer), be a worker, or be a recipient (family).
model User {
  id          String    @id @default(cuid())
  /// Lowercased 0x address of the Privy embedded wallet
  address     String    @unique
  /// Privy user id (did:privy:...). Null for accounts created before Privy.
  privyId     String?   @unique
  displayName String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  companies       Company[]
  employments     Worker[]
  /// People this user (as a worker) sends part of their salary to
  recipients      Recipient[]   @relation("RecipientOwner")
  /// Workers who added this user as their recipient
  recipientOf     Recipient[]   @relation("RecipientUser")
  invitesCreated  Invite[]      @relation("InviteCreatedBy")
  invitesAccepted Invite[]      @relation("InviteAcceptedBy")
  payouts         Payout[]
  sessions        Session[]
  demoStream      DemoStream?
  bankAccounts    BankAccount[]
}

/// API session. Only the SHA-256 of the bearer token is stored, so a leaked
/// database cannot be used to sign in.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Company profile of an employer. At most one active (not deleted) company
/// per owner; the service enforces it.
model Company {
  id        String    @id @default(cuid())
  ownerId   String
  name      String
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: the row stays so employments, invites and history keep their company.
  deletedAt DateTime?

  owner   User     @relation(fields: [ownerId], references: [id])
  workers Worker[]
  invites Invite[]

  @@index([ownerId])
}

/// A person employed by a company: their account plus job metadata. The salary
/// here is a reference for the UI; actual pay is the on-chain stream.
model Worker {
  id                 String    @id @default(cuid())
  companyId          String
  userId             String
  displayName        String
  /// Job title, e.g. "Caregiver"
  position           String?
  monthlySalaryCents Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// Soft delete. Re-adding the same person restores this row.
  deletedAt          DateTime?

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
}

/// A family member a worker sends part of their salary to. The split itself
/// (who and how many bps) lives on-chain in `setSplit`; this is the address book.
model Recipient {
  id          String    @id @default(cuid())
  /// The worker (user id) who owns this entry
  ownerId     String
  /// The recipient's account
  userId      String
  displayName String
  /// e.g. "Ibu", "Istri"
  relation    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete. Re-adding the same person restores this row.
  deletedAt   DateTime?

  owner User @relation("RecipientOwner", fields: [ownerId], references: [id])
  user  User @relation("RecipientUser", fields: [userId], references: [id])

  @@unique([ownerId, userId])
  @@index([userId])
}

model Invite {
  id                 String       @id @default(cuid())
  code               String       @unique
  type               InviteType
  status             InviteStatus @default(PENDING)
  createdById        String
  /// Set for WORKER invites
  companyId          String?
  inviteeName        String
  /// Set for WORKER invites
  monthlySalaryCents Int?
  /// Set for RECIPIENT invites, e.g. "Ibu", "Istri"
  relation           String?
  acceptedById       String?
  acceptedAt         DateTime?
  expiresAt          DateTime
  createdAt          DateTime     @default(now())

  createdBy  User     @relation("InviteCreatedBy", fields: [createdById], references: [id])
  company    Company? @relation(fields: [companyId], references: [id])
  acceptedBy User?    @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([createdById])
  @@index([companyId])
}

/// One drip per address, ever. The unique constraint is the idempotency guard.
model GasDrip {
  id        String        @id @default(cuid())
  address   String        @unique
  amountWei String
  status    GasDripStatus @default(PENDING)
  txHash    String?
  error     String?
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdAt])
}

/// Where a recipient cashes out (PLAN §6.3). The account number is only
/// stored encrypted (AES-256-GCM, `BANK_ENCRYPTION_KEY`); the API returns the
/// last 4 digits and never the full number.
model BankAccount {
  id                String    @id @default(cuid())
  userId            String
  /// Bank code, e.g. BCA, BNI, MANDIRI
  bankCode          String
  /// Name on the account, as the bank knows it
  accountName       String
  /// Optional nickname, e.g. "Rekening utama"
  label             String?
  /// `v1.<iv>.<tag>.<ciphertext>`, with the user id as AAD
  numberEncrypted   String
  numberLast4       String
  /// HMAC of bank code + number: finds duplicates without decrypting
  numberFingerprint String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@unique([userId, numberFingerprint])
}

/// Judge mode: one real testnet stream from the demo employer per account,
/// ever. The unique `userId` is the idempotency guard, like `GasDrip.address`.
/// The stream itself (balance, withdrawals) lives on the contract.
model DemoStream {
  id              String           @id @default(cuid())
  userId          String           @unique
  /// Worker address the stream pays, lowercased
  address         String
  /// Token units (6 decimals)
  amountUnits     String
  durationSeconds Int
  status          DemoStreamStatus @default(PENDING)
  /// On-chain stream id, as a decimal string
  streamId        String?
  txHash          String?
  startsAt        DateTime?
  endsAt          DateTime?
  error           String?
  ip              String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([ip, createdAt])
}

/// A recipient's cash-out: a verified on-chain token transfer to PAYOUT_ADDRESS,
/// paid out in IDR to one of their bank accounts by a sandbox provider.
/// The bank details stay in `BankAccount` (encrypted), never copied here.
model Payout {
  id            String       @id @default(cuid())
  userId        String
  bankAccountId String
  /// Token transfer from the recipient to the payout address. Unique: one payout per transfer.
  sourceTxHash  String       @unique
  /// Token units (6 decimals) the transfer moved
  amountUnits   String
  amountIdr     Int?
  /// IDR per USD used for `amountIdr`, and where it came from (live/cache/fallback)
  fxRate        Float?
  fxSource      String?
  provider      String
  providerRef   String?      @unique
  status        PayoutStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([userId])
  @@index([bankAccountId])
}

/// Cache of TricklePayroll streams, filled by the stream indexer from
/// `nextStreamId` + `getStream` (no event scan). The contract stays the source of
/// truth (PLAN §4.2): rows are re-read until settled, and checks that block an
/// action re-read their candidates on-chain first.
model Stream {
  /// On-chain stream id
  id             BigInt   @id
  /// Lowercased 0x address that funded the stream
  employer       String
  /// Lowercased 0x address that is paid
  worker         String
  /// Token units (6 decimals)
  amountUnits    String
  withdrawnUnits String
  refundedUnits  String
  startsAt       DateTime
  endsAt         DateTime
  canceled       Boolean
  /// `withdrawn + refunded == amount`: nothing can change any more, so the indexer stops re-reading it
  settled        Boolean
  syncedAt       DateTime @updatedAt

  @@index([employer, worker])
  @@index([worker])
  @@index([settled])
}
