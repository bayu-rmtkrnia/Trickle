# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# Database (local: `pnpm db:up` from repo root)
DATABASE_URL=postgresql://trickle:trickle@localhost:5433/trickle

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Web app domain/origin: used in the sign-in message and invite links
AUTH_DOMAIN=localhost:3000
WEB_URL=http://localhost:3000

# Chain (Monad testnet)
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz

# Gas drip treasury (testnet only, never commit a real key)
GAS_TREASURY_PRIVATE_KEY=
GAS_DRIP_AMOUNT_MON=0.05
GAS_DRIP_DAILY_LIMIT=200

# FX
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_SECONDS=600
FX_FALLBACK_USD_IDR=16500

# Dev only: key used by `pnpm sign` to produce test signatures for Postman
DEV_SIGNER_PRIVATE_KEY=
