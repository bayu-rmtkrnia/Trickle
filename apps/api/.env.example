# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# Database (local: `pnpm db:up` from repo root)
DATABASE_URL=postgresql://trickle:trickle@localhost:5433/trickle

# Auth (Privy). Without PRIVY_APP_ID, POST /api/v1/sessions answers 503.
# App ID and App secret: Privy dashboard > App settings > Basics. The secret stays server-side.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Privy dashboard > App settings > Verification key (PEM, \n for newlines).
# When empty, keys are fetched from Privy's JWKS endpoint.
PRIVY_VERIFICATION_KEY=
SESSION_TTL_DAYS=7
# Web app origin: used in invite links
WEB_URL=http://localhost:3000

# Chain (Monad testnet)
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz

# Gas drip treasury (testnet only, never commit a real key)
GAS_TREASURY_PRIVATE_KEY=
GAS_DRIP_AMOUNT_MON=0.05
GAS_DRIP_DAILY_LIMIT=200

# FX
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_SECONDS=600
FX_FALLBACK_USD_IDR=16500
