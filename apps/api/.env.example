# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# Database (local: `pnpm db:up` from repo root)
DATABASE_URL=postgresql://trickle:trickle@localhost:5433/trickle

# Auth (Privy). Without PRIVY_APP_ID, POST /api/v1/sessions answers 503.
# App ID and App secret: Privy dashboard > App settings > Basics. The secret stays server-side.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: Privy dashboard > App settings > Verification key (PEM, \n for newlines).
# When empty, keys are fetched from Privy's JWKS endpoint.
PRIVY_VERIFICATION_KEY=
SESSION_TTL_DAYS=7
# Web app origin: used in invite links
WEB_URL=http://localhost:3000

# Chain (Monad testnet)
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
# TricklePayroll on Monad testnet (packages/shared/deployments/testnet.json).
# Empty = recipient deletes skip the on-chain split check.
PAYROLL_ADDRESS=0xE7292E797009E9D53102ec132Ef4Ae549cDD652e

# Gas drip treasury (testnet only, never commit a real key)
GAS_TREASURY_PRIVATE_KEY=
GAS_DRIP_AMOUNT_MON=0.05
GAS_DRIP_DAILY_LIMIT=200
GAS_DRIP_IP_DAILY_LIMIT=5

# Encrypts bank account numbers at rest: `openssl rand -hex 32`. Never commit a real key,
# and do not change it once data exists (old numbers become unreadable).
# Empty = POST /api/v1/bank-accounts answers 503.
BANK_ENCRYPTION_KEY=

# Payouts: recipients transfer mock AUSD here, then the (mock) sandbox provider pays IDR.
# Any address the team controls. Empty = POST /api/v1/payouts answers 503.
PAYOUT_ADDRESS=
# Shared secret for POST /api/v1/webhooks/payout-provider: `openssl rand -hex 32`.
PAYOUT_WEBHOOK_SECRET=
MOCK_PAYOUT_SECONDS=15

# Judge mode demo employer (testnet only, never commit a real key).
# Needs PAYROLL_ADDRESS and some MON for gas; it mints its own mock AUSD.
# Empty = POST /api/v1/demo-streams answers 503.
DEMO_EMPLOYER_PRIVATE_KEY=
DEMO_STREAM_AMOUNT_USD=50
DEMO_STREAM_MINUTES=60
DEMO_STREAM_DAILY_LIMIT=100
DEMO_STREAM_IP_DAILY_LIMIT=5

# FX
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_SECONDS=600
FX_FALLBACK_USD_IDR=16500
